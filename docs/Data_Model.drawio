        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    OUTLETS ||--o{ ORDERS : \&quot;places\&quot;\n    OUTLETS ||--o{ TRIP_STOPS : \&quot;visited_at\&quot;\n    VEHICLES ||--o{ TRIPS : \&quot;assigned_to\&quot;\n    TRIPS ||--|{ TRIP_STOPS : \&quot;contains\&quot;\n    USERS ||--o{ ORDERS : \&quot;managed_by\&quot;\n    USERS ||--o{ TRIPS : \&quot;driven_by\&quot;\n\n    OUTLETS {\n        string outlet_id PK \&quot;OUT001 - OUT120\&quot;\n        string brand \&quot;Fresh, Style, Tech\&quot;\n        string district \&quot;Colombo, Kandy, etc.\&quot;\n        string depot \&quot;Peliyagoda, Kandy\&quot;\n        string dock_type \&quot;rear_dock, street, mall_bay\&quot;\n        string parking_constraint \&quot;van_only, normal, mall_dock\&quot;\n        string window_open_time \&quot;05:00\&quot;\n        string window_close_time \&quot;07:30\&quot;\n    }\n\n    VEHICLES {\n        string vehicle_id PK \&quot;VEH001 - VEH060\&quot;\n        string type \&quot;van, truck\&quot;\n        string temp \&quot;ambient, reefer\&quot;\n        float weight_cap_kg \&quot;Max payload capacity\&quot;\n        float volume_cap_m3 \&quot;Max volume capacity\&quot;\n        string fuel_type \&quot;diesel, petrol\&quot;\n        float weekly_fuel_quota_l \&quot;Weekly fuel limit\&quot;\n        string depot \&quot;Peliyagoda, Kandy\&quot;\n    }\n\n    USERS {\n        int id PK\n        string email UK\n        string name \&quot;User Full Name\&quot;\n        string role \&quot;DISPATCHER, STORE_MANAGER, LOADER, DRIVER\&quot;\n        string assigned_scope \&quot;Depot or Outlet ID\&quot;\n    }\n\n    ORDERS {\n        string order_id PK \&quot;e.g. WF-1043\&quot;\n        string outlet_id FK\n        date delivery_date\n        string brand \&quot;Fresh, Style, Tech\&quot;\n        float weight_kg\n        float volume_m3\n        int crate_count\n        boolean requires_chilled\n        string status \&quot;CONFIRMED, PLANNED, DEFERRED, DELIVERED\&quot;\n    }\n\n    TRIPS {\n        string trip_id PK \&quot;e.g. TRIP-WF-1043\&quot;\n        string vehicle_id FK\n        string driver_name\n        string depot\n        int trip_number \&quot;1 or 2 (Max 2 trips/day)\&quot;\n        date delivery_date\n        float total_weight_kg\n        float total_volume_m3\n        string status \&quot;PLANNED, ON_ROUTE, DEGRADED_OFFLINE, COMPLETED\&quot;\n        timestamp last_sync_time\n        boolean is_telemetry_stale\n    }\n\n    TRIP_STOPS {\n        int id PK\n        string trip_id FK\n        string outlet_id FK\n        int stop_sequence \&quot;LIFO order for loading\&quot;\n        string eta_start \&quot;07:12\&quot;\n        string eta_end \&quot;07:34\&quot;\n        string status \&quot;PLANNED, DELIVERED, FAILED\&quot;\n        string discrepancy_note \&quot;e.g. Milk short by 3 units\&quot;\n        boolean is_offline_record\n        timestamp completed_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RScmwHZY1_aD7Rs9ALCX-1">
